{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/work",
      "destination": "/pages/work/",
      "permanent": true
    },
    {
      "source": "/work/",
      "destination": "/pages/work/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/pages/about/",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/pages/about/",
      "permanent": true
    },
    {
      "source": "/playground",
      "destination": "/pages/playground/",
      "permanent": true
    },
    {
      "source": "/playground/",
      "destination": "/pages/playground/",
      "permanent": true
    },
    {
      "source": "/articles",
      "destination": "/pages/articles/",
      "permanent": true
    },
    {
      "source": "/articles/",
      "destination": "/pages/articles/",
      "permanent": true
    },
    {
      "source": "/work/:id",
      "destination": "/pages/work/project/?id=:id",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/pages/work/project",
      "destination": "/api/project"
    },
    {
      "source": "/pages/work/project/",
      "destination": "/api/project"
    }
  ],
  "functions": {
    "api/project.js": {
      "includeFiles": "{dist/,}{pages/work/project/template.html,data/snapshot.json}"
    }
  },
  "headers": [
    {
      "source": "/image/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/fonts/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
